# Personal colour preferences
axes.prop_cycle : cycler('color', ['3073ae', '8fb359', 'e0a95c', 'd9729c', 'ff4e2b', '93789f', '6e7ec2', '4aa8a1', '4eb975', 'b58463', '5a5959', '9e9e9e'])

# --- Typography & Fonts (from nature.mplstyle) ---
font.family : sans-serif
font.sans-serif : Helvetica Neue, DejaVu Sans, Arial, Lucida Grande, Verdana, Geneva, Lucid, Avant Garde, sans-serif
mathtext.fontset : dejavusans

font.size : 12
axes.labelsize : 13
axes.titlesize : 13
xtick.labelsize : 11
ytick.labelsize : 11
legend.fontsize : 11

# --- Axes & Spines (from science.mplstyle) ---
axes.linewidth : 0.5
grid.linewidth : 0.5
lines.linewidth : 1.0
lines.markersize : 3

# --- X-Ticks (inward ticks on all 4 sides) ---
xtick.direction : in
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.size : 1.5
xtick.minor.width : 0.5
xtick.minor.visible : True
xtick.top : True

# --- Y-Ticks (inward ticks on all 4 sides) ---
ytick.direction : in
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.size : 1.5
ytick.minor.width : 0.5
ytick.minor.visible : True
ytick.right : True

# --- Legend & Saving ---
legend.frameon : False
savefig.bbox : tight
savefig.pad_inches : 0.05
savefig.dpi : 300

# --- LaTeX (Disabled by default so it works without a TeX installation) ---
text.usetex : False